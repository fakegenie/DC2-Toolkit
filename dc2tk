#!/bin/sh
# Runs dc2tk from the repository folder: build/release/dc2tk (dc2tk.exe on Windows), built first when missing.
here=$(cd "$(dirname "$0")" && pwd)
exe="$here/build/release/dc2tk"
[ -f "$exe.exe" ] && exe="$exe.exe"
if [ ! -f "$exe" ]; then
    (cd "$here/src" && cargo build --release) || exit 1
    [ -f "$exe.exe" ] && exe="$exe.exe"
fi
exec "$exe" "$@"
