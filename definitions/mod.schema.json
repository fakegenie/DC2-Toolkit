{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dc2tk mod.json, format 2",
  "type": "object",
  "required": ["format", "id", "version"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "format": {"const": 2},
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/version"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "license": {"type": "string"},
    "homepage": {"type": "string"},
    "game": {"enum": ["dc2-pal"]},
    "tool": {"$ref": "#/$defs/range"},
    "targets": {
      "type": "array",
      "items": {"enum": ["iso", "native"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "dependencies": {"$ref": "#/$defs/ranges"},
    "after": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "conflicts": {"$ref": "#/$defs/ranges"},
    "replace": {"$ref": "#/$defs/lines"},
    "add": {"$ref": "#/$defs/lines"},
    "files": {"$ref": "#/$defs/lines"},
    "data": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {"type": "array", "items": {"type": "object"}},
          {
            "type": "object",
            "required": ["file"],
            "additionalProperties": false,
            "properties": {"file": {"type": "string"}, "when": {"type": "string"}}
          }
        ]
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "properties": {"when": {"type": "string"}},
            "patternProperties": {"^[0-9]+$": {"type": "string"}},
            "additionalProperties": false
          }
        ]
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {"type": "array", "items": {"type": "string"}},
        "whole": {"type": "object", "additionalProperties": {"type": "string"}},
        "additions": {"type": "array", "items": {"$ref": "#/$defs/addition"}}
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {"type": "array", "items": {"type": "string"}},
        "api": {"$ref": "#/$defs/range"},
        "settings": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        }
      }
    },
    "settings": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/setting"}
    },
    "dev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"start_at": {"type": "string"}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "range": {"type": "string", "minLength": 1},
    "ranges": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/range"}
    },
    "lines": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["file"],
            "additionalProperties": false,
            "properties": {
              "file": {"type": "string"},
              "only": {
                "oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]
              },
              "volume": {"type": "integer", "minimum": 0, "maximum": 127},
              "bank": {"type": "string"},
              "like": {"type": "string"},
              "instruments": {"type": "object"},
              "title": {"type": "string"},
              "script": {"type": "string"},
              "compact": {"type": "boolean"},
              "programs": {
                "type": "object",
                "additionalProperties": {"type": ["string", "integer"]}
              },
              "when": {"type": "string"}
            }
          }
        ]
      }
    },
    "setting": {
      "type": "object",
      "required": ["type", "default"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["bool", "int", "enum", "string"]},
        "default": {},
        "label": {"type": "string"},
        "min": {"type": "integer"},
        "max": {"type": "integer"},
        "values": {"type": "array", "items": {"type": "string"}}
      }
    },
    "addition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "map": {"type": "string"},
        "scripts": {"type": "array", "items": {"type": "string"}},
        "programs": {"type": "object", "additionalProperties": {"type": "string"}},
        "includes": {"type": "array", "items": {"type": "string"}},
        "wrap": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "before": {"type": "array", "items": {"type": "string"}},
              "after": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
